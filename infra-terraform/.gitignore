# Local Terraform directories
.terraform/

# State files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Lock file (can be committed, but often ignored per project policy)
.terraform.lock.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated plan files
*.tfplan
*.tfplan.*

# Sensitive variable files
#*.tfvars
*.tfvars.json

# Local CLI configuration
.terraformrc
terraform.rc

# Backup files
*.backup

# Environment files
.env

# Plan output
plan.out

secrets.txt
k8s-manifests/secret.yaml
*.secret.yaml